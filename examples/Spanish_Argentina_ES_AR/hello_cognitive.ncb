; ============================================================================
; NeuroCOBOL V3.0 Cognitive Program
; Language: Spanish (Argentina) / Español (Argentina) (es_ar)
; UPL+ Sovereign Grade Standard
; ============================================================================

PROGRAM_ES_AR COGNITIVE_DEMO.

DATA_ES_AR
    DEFINE CUENTA AS COMPRESSED(10,2).

LOGIC_ES_AR
    SHOW "NeuroCOBOL V3.0 en linea (Spanish (Argentina) / Español (Argentina))"
    COMPUTE CUENTA = 1000 + 500 - 50
    SHOW CUENTA
    
    IF CUENTA > 500 THEN
        SHOW "Validacion de Orquestacion: APROBADA"
    END_IF

END
