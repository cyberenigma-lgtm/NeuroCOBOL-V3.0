; ============================================================================
; NeuroCOBOL V3.0 Cognitive Program
; Language: Vietnamese / Tiếng Việt (vi)
; UPL+ Sovereign Grade Standard
; ============================================================================

PROGRAM_VI COGNITIVE_DEMO.

DATA_VI
    DEFINE CUENTA AS COMPRESSED(10,2).

LOGIC_VI
    SHOW "NeuroCOBOL V3.0 en linea (Vietnamese / Tiếng Việt)"
    COMPUTE CUENTA = 1000 + 500 - 50
    SHOW CUENTA
    
    IF CUENTA > 500 THEN
        SHOW "Validacion de Orquestacion: APROBADA"
    END_IF

END
