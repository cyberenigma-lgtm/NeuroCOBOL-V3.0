; ============================================================================
; NeuroCOBOL V3.0 Cognitive Program
; Language: Spanish (Mexico) / Español (México) (es_mx)
; UPL+ Sovereign Grade Standard
; ============================================================================

PROGRAM_ES_MX COGNITIVE_DEMO.

DATA_ES_MX
    DEFINE CUENTA AS COMPRESSED(10,2).

LOGIC_ES_MX
    SHOW "NeuroCOBOL V3.0 en linea (Spanish (Mexico) / Español (México))"
    COMPUTE CUENTA = 1000 + 500 - 50
    SHOW CUENTA
    
    IF CUENTA > 500 THEN
        SHOW "Validacion de Orquestacion: APROBADA"
    END_IF

END
