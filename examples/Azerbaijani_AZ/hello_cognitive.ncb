; ============================================================================
; NeuroCOBOL V3.0 Cognitive Program
; Language: Azerbaijani / Azərbaycan (az)
; UPL+ Sovereign Grade Standard
; ============================================================================

PROGRAM_AZ COGNITIVE_DEMO.

DATA_AZ
    DEFINE CUENTA AS COMPRESSED(10,2).

LOGIC_AZ
    SHOW "NeuroCOBOL V3.0 en linea (Azerbaijani / Azərbaycan)"
    COMPUTE CUENTA = 1000 + 500 - 50
    SHOW CUENTA
    
    IF CUENTA > 500 THEN
        SHOW "Validacion de Orquestacion: APROBADA"
    END_IF

END
