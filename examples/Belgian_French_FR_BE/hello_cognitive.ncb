; ============================================================================
; NeuroCOBOL V3.0 Cognitive Program
; Language: Belgian French / Français (Belgique) (fr_be)
; UPL+ Sovereign Grade Standard
; ============================================================================

PROGRAM_FR_BE COGNITIVE_DEMO.

DATA_FR_BE
    DEFINE CUENTA AS COMPRESSED(10,2).

LOGIC_FR_BE
    SHOW "NeuroCOBOL V3.0 en linea (Belgian French / Français (Belgique))"
    COMPUTE CUENTA = 1000 + 500 - 50
    SHOW CUENTA
    
    IF CUENTA > 500 THEN
        SHOW "Validacion de Orquestacion: APROBADA"
    END_IF

END
