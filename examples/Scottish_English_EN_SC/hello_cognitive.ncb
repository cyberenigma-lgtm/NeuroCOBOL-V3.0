; ============================================================================
; NeuroCOBOL V3.0 Cognitive Program
; Language: Scottish English / Scots (en_sc)
; UPL+ Sovereign Grade Standard
; ============================================================================

PROGRAM_EN_SC COGNITIVE_DEMO.

DATA_EN_SC
    DEFINE CUENTA AS COMPRESSED(10,2).

LOGIC_EN_SC
    SHOW "NeuroCOBOL V3.0 en linea (Scottish English / Scots)"
    COMPUTE CUENTA = 1000 + 500 - 50
    SHOW CUENTA
    
    IF CUENTA > 500 THEN
        SHOW "Validacion de Orquestacion: APROBADA"
    END_IF

END
