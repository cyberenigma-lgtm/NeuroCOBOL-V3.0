; ============================================================================
; NeuroCOBOL V3.0 Cognitive Program
; Language: Macedonian / Македонски (mk)
; UPL+ Sovereign Grade Standard
; ============================================================================

PROGRAM_MK COGNITIVE_DEMO.

DATA_MK
    DEFINE CUENTA AS COMPRESSED(10,2).

LOGIC_MK
    SHOW "NeuroCOBOL V3.0 en linea (Macedonian / Македонски)"
    COMPUTE CUENTA = 1000 + 500 - 50
    SHOW CUENTA
    
    IF CUENTA > 500 THEN
        SHOW "Validacion de Orquestacion: APROBADA"
    END_IF

END
