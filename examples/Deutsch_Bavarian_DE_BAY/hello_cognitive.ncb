PROGRAMM COGNITIVE_DEMO.

DATEN
    DEFINIERE CUENTA ALS KOMPRIMIERT(10,2).

LOGIK
    ZEIGE "NeuroCOBOL V3.0 en linea (Deutsch (Bavarian))"
