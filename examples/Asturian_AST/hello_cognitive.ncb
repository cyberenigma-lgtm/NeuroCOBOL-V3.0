; ============================================================================
; NeuroCOBOL V3.0 Cognitive Program
; Language: Asturian / Asturianu (ast)
; UPL+ Sovereign Grade Standard
; ============================================================================

PROGRAM_AST COGNITIVE_DEMO.

DATA_AST
    DEFINE CUENTA AS COMPRESSED(10,2).

LOGIC_AST
    SHOW "NeuroCOBOL V3.0 en linea (Asturian / Asturianu)"
    COMPUTE CUENTA = 1000 + 500 - 50
    SHOW CUENTA
    
    IF CUENTA > 500 THEN
        SHOW "Validacion de Orquestacion: APROBADA"
    END_IF

END
