; ============================================================================
; NeuroCOBOL V3.0 Cognitive Program
; Language: Scottish Gaelic / Gàidhlig (gd)
; UPL+ Sovereign Grade Standard
; ============================================================================

PROGRAM_GD COGNITIVE_DEMO.

DATA_GD
    DEFINE CUENTA AS COMPRESSED(10,2).

LOGIC_GD
    SHOW "NeuroCOBOL V3.0 en linea (Scottish Gaelic / Gàidhlig)"
    COMPUTE CUENTA = 1000 + 500 - 50
    SHOW CUENTA
    
    IF CUENTA > 500 THEN
        SHOW "Validacion de Orquestacion: APROBADA"
    END_IF

END
